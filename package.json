{
  "name": "agent-harness-skeleton",
  "version": "0.1.0",
  "type": "module",
  "description": "A minimal, safe, terminable agent loop skeleton: OpenAI protocol + runtime guard shell + pluggable security doors + session isolation. Zero runtime dependencies.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "examples",
    "docs/ARCHITECTURE.md",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example:minimal": "tsx examples/minimal.ts",
    "example:guard-demo": "tsx examples/guard-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {},
  "license": "MIT"
}
